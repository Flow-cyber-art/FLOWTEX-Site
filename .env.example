# Formularz kontaktowy (EmailJS) — wartości z panelu https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ADMIN_ID=
VITE_EMAILJS_TEMPLATE_CLIENT_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Analityka (opcjonalnie). Ustaw JEDNĄ z dwóch pierwszych zmiennych:
#  - VITE_GTM_ID: kontener Google Tag Manager (GTM-XXXXXXX) — zdarzenia trafiają do dataLayer
#  - VITE_GA4_ID: sam Google Analytics 4 (G-XXXXXXXXXX), bez konfiguracji GTM
# Bez nich nic się nie ładuje, a baner cookies jest zwykłym komunikatem.
# Szczegóły: docs/analityka.md
VITE_GTM_ID=
VITE_GA4_ID=
# Kod weryfikacyjny Google Search Console (metatag); zbędny przy weryfikacji przez DNS
VITE_GSC_VERIFICATION=

# Formularz kontaktowy (EmailJS) — wartości z panelu https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ADMIN_ID=
VITE_EMAILJS_TEMPLATE_CLIENT_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Analityka (ustawiane w Vercelu: Project → Settings → Environment Variables).
#  - GTM_ID: kontener Google Tag Manager, dla FLOWTEX: GTM-N44NN9NF
#  - GA4_ID: alternatywa bez GTM — samo GA4 (G-XXXXXXXXXX); pomijane, gdy jest GTM_ID
# Bez nich nic się nie ładuje, a baner cookies jest zwykłym komunikatem.
# Szczegóły: docs/analityka.md
GTM_ID=
GA4_ID=
# Kod weryfikacyjny Google Search Console (metatag); zbędny przy weryfikacji przez DNS
VITE_GSC_VERIFICATION=

# Materiały do pobrania (np. protokół odbioru): szablon EmailJS z linkiem dla osoby
# pobierającej. Zmienne szablonu: {{name}}, {{email}} (adresat), {{resource_name}},
# {{download_url}}, {{message}}. Opcjonalne: bez tej zmiennej mail z linkiem idzie
# szablonem VITE_EMAILJS_TEMPLATE_CLIENT_ID (link w {{message}}).
VITE_EMAILJS_TEMPLATE_MATERIAL_ID=

# Zapis leadów do arkusza Google (tylko po stronie serwera — BEZ prefiksu VITE_).
# Instrukcja i skrypt Apps Script: docs/leady-google-sheets.md
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

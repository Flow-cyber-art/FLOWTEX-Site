#!/bin/sh
# Auto-instalowany przez `npm install` (patrz package.json "prepare" i
# scripts/install-git-hooks.js). Przed każdym commitem: jeśli commitujesz
# zmiany w src/data/defects.js, dopisuje aktualną datę do pola `updated`
